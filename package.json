{
  "name": "intelecto-backend",
  "version": "0.1.0",
  "private": true,
  "description": "API del Sistema de Ventas Intelecto (SVI)",
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,test}/**/*.ts\"",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:cov": "jest --coverage",
    "usuario:password": "nest build && node scripts/establecer-password.js"
  },
  "dependencies": {
    "@nestjs/common": "12.3.3",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "12.3.3",
    "@nestjs/jwt": "12.0.3",
    "@nestjs/platform-express": "12.3.3",
    "@nestjs/swagger": "12.1.0",
    "@nestjs/throttler": "6.7.1",
    "@nestjs/typeorm": "12.0.2",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "decimal.js": "10.6.0",
    "exceljs": "4.4.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nestjs/cli": "12.0.11",
    "@nestjs/schematics": "12.0.12",
    "@nestjs/testing": "12.3.3",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pg": "8.23.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.14.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "ts-jest": "29.4.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "overrides": {
    "glob@>=9.0.0 <14.0.2": "14.0.3",
    "minimatch@>=7.0.0 <11.0.1": "11.0.5",
    "exceljs": {
      "uuid": "11.1.1"
    },
    "test-exclude": {
      "minimatch": "11.0.5"
    }
  }
}
