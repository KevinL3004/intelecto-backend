# ---- Servidor ----
NODE_ENV=development
PORT=3000
TZ=UTC
CORS_ORIGIN=http://localhost:4200

# ---- Base de datos ----
# Local (docker compose up -d): localhost si la API corre con npm; con --profile api el compose la sobreescribe
DATABASE_URL=postgresql://intelecto:intelecto_dev@localhost:5434/intelecto
DATABASE_SSL=false   # true en producción (Neon): verifica el certificado del servidor

# ---- Sesión ----
# OBLIGATORIO generar un valor propio (mínimo 32 caracteres): openssl rand -hex 32
# La API no arranca con este valor de ejemplo.
JWT_SECRET=GENERAR_con_openssl_rand_hex_32
JWT_EXPIRES_IN=15m          # token de acceso (corto)
# El refresh token es opaco y rotativo (tabla sesion); esta es la vida máxima de la sesión:
JWT_REFRESH_EXPIRES_IN=7d

# ---- Fase 2 (apagado en v1.0) ----
FEATURE_PORTAL_CLIENTES=false
FEATURE_PAGOS_LINEA=false
FEATURE_FEL=false
PAGOS_PROVEEDOR=manual
FEL_PROVEEDOR=manual

# ---- Docker local (docker-compose.yml: postgres + pgadmin) ----
POSTGRES_DB=intelecto
POSTGRES_USER=intelecto
POSTGRES_PASSWORD=intelecto_dev
PGADMIN_EMAIL=admin@intelecto.com
PGADMIN_PASSWORD=admin
